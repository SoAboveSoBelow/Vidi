-- AM (A_THE_VIEWED_PROBE_READS_ONLY_INDEXES): make the hide-viewed read
-- index-only.
--
-- getViewedAnimeIdsBySource walks animes -> episodes -> history. The first two
-- hops are already index-only (idx_animes_source and episodes_anime_id_index
-- both carry the rowid they join on), but history is reached through the
-- UNIQUE(episode_id) autoindex, which does not carry last_seen - so every probe
-- loaded the history row off the table page just to read it.
--
-- Measured at 100k entries: 73ms -> 67ms. Small, because the autoindex was
-- already doing the lookup and only the row fetch is saved; two lines for 8% on
-- a query that runs whenever a source listing opens with the trim on.
CREATE INDEX idx_history_episode_last_seen ON history(episode_id, last_seen);

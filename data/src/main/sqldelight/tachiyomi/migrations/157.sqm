import kotlin.Boolean;

-- AM (ART_PROVENANCE) -->
-- Provenance for frame-grab art, so a cover or thumbnail captured from a video
-- can be regenerated after a restore instead of being lost. See
-- custom_art_source.sq for the column semantics.
CREATE TABLE custom_art_source(
    anime_id INTEGER NOT NULL,
    art_type INTEGER NOT NULL,
    episode_url TEXT NOT NULL,
    position_ms INTEGER NOT NULL,
    with_subtitles INTEGER AS Boolean NOT NULL DEFAULT 0,
    status INTEGER NOT NULL DEFAULT 0,
    attempts INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(anime_id, art_type, episode_url),
    FOREIGN KEY(anime_id) REFERENCES animes(_id)
    ON DELETE CASCADE
);

CREATE INDEX custom_art_source_status_index ON custom_art_source(status);
-- <-- AM (ART_PROVENANCE)

-- AM (DOWNLOAD_RESTORE) -->
-- Episodes a backup says were downloaded elsewhere and are not downloaded here
-- yet. See pending_download_restore.sq.
CREATE TABLE pending_download_restore(
    anime_id INTEGER NOT NULL,
    episode_id INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY(anime_id, episode_id),
    FOREIGN KEY(anime_id) REFERENCES animes(_id)
    ON DELETE CASCADE,
    FOREIGN KEY(episode_id) REFERENCES episodes(_id)
    ON DELETE CASCADE
);

CREATE INDEX pending_download_restore_episode_id_index ON pending_download_restore(episode_id);
-- <-- AM (DOWNLOAD_RESTORE)

-- AM (PLAYBACK_QUEUE) -->
-- The playback queue: an ordered list of what plays next, surviving process
-- death. See queue_blocks.sq and queue_items.sq for what a row means and why
-- the order is banded into blocks rather than flat.
CREATE TABLE queue_blocks(
    _id INTEGER NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    anime_id INTEGER,
    fill_state INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(anime_id) REFERENCES animes(_id)
    ON DELETE CASCADE
);

CREATE INDEX queue_blocks_position_index ON queue_blocks(position);
CREATE INDEX queue_blocks_anime_id_index ON queue_blocks(anime_id);

CREATE TABLE queue_items(
    _id INTEGER NOT NULL PRIMARY KEY,
    block_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    anime_id INTEGER,
    episode_id INTEGER,
    uri TEXT,
    FOREIGN KEY(block_id) REFERENCES queue_blocks(_id)
    ON DELETE CASCADE,
    FOREIGN KEY(anime_id) REFERENCES animes(_id)
    ON DELETE CASCADE,
    FOREIGN KEY(episode_id) REFERENCES episodes(_id)
    ON DELETE CASCADE,
    CHECK (
        (anime_id IS NOT NULL AND episode_id IS NOT NULL AND uri IS NULL)
        OR (anime_id IS NULL AND episode_id IS NULL AND uri IS NOT NULL)
    )
);

CREATE INDEX queue_items_block_id_index ON queue_items(block_id);
CREATE INDEX queue_items_anime_id_index ON queue_items(anime_id);
CREATE INDEX queue_items_episode_id_index ON queue_items(episode_id);
-- <-- AM (PLAYBACK_QUEUE)

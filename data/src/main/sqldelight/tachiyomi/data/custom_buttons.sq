findAll:
SELECT *
FROM custom_buttons
ORDER BY sortIndex;

insert:
INSERT INTO custom_buttons(name, isFavorite, sortIndex, content, doubleTapContent, longPressContent, onStartup, icon, isToggle)
VALUES (:name, :isFavorite, :sortIndex, :content, :doubleTapContent, :longPressContent, :onStartup, :icon, :isToggle);

insertReturningId:
INSERT INTO custom_buttons(name, isFavorite, sortIndex, content, doubleTapContent, longPressContent, onStartup, icon, isToggle)
VALUES (:name, :isFavorite, :sortIndex, :content, :doubleTapContent, :longPressContent, :onStartup, :icon, :isToggle)
RETURNING _id;

delete:
DELETE FROM custom_buttons
WHERE _id = :customButtonId;

update:
UPDATE custom_buttons
SET name = coalesce(:name, name),
    isFavorite = coalesce(:isFavorite, isFavorite),
    sortIndex = coalesce(:sortIndex, sortIndex),
    content = coalesce(:content, content),
    doubleTapContent = coalesce(:doubleTapContent, doubleTapContent),
    longPressContent = coalesce(:longPressContent, longPressContent),
    onStartup = coalesce(:onStartup, onStartup),
    icon = coalesce(:icon, icon),
    isToggle = coalesce(:isToggle, isToggle)
WHERE _id = :customButtonId;
-- <-- AY

import java.util.Date;

CREATE TABLE history(
    _id INTEGER NOT NULL PRIMARY KEY,
    episode_id INTEGER NOT NULL UNIQUE,
    last_seen INTEGER AS Date,
    -- AM (HISTORY_ORIGIN): 0 = watched in the player, 1 = seen in the browse
    -- feed. See HistoryOrigin, and the upsert below for why a feed write may
    -- not take a row the player owns.
    origin INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(episode_id) REFERENCES episodes (_id)
    ON DELETE CASCADE
);

CREATE INDEX history_history_episode_id_index ON history(episode_id);
CREATE INDEX idx_history_last_seen ON history(last_seen);

getHistoryByAnimeId:
SELECT
H._id,
H.episode_id,
H.last_seen
FROM history H
JOIN episodes EP
ON H.episode_id = EP._id
WHERE EP.anime_id = :animeId AND EP._id = H.episode_id;

getHistoryByEpisodeUrlAndAnimeId:
SELECT
H._id,
H.episode_id,
H.last_seen
FROM history H
JOIN episodes EP
ON H.episode_id = EP._id
WHERE EP.url = :episodeUrl AND EP.anime_id = :animeId AND EP._id = H.episode_id
LIMIT 1;

resetHistoryById:
UPDATE history
SET last_seen = 0
WHERE _id = :historyId;

resetHistoryByAnimeId:
UPDATE history
SET last_seen = 0
WHERE _id IN (
    SELECT H._id
    FROM animes A
    INNER JOIN episodes EP
    ON A._id = EP.anime_id
    INNER JOIN history H
    ON EP._id = H.episode_id
    WHERE A._id = :animeId
);

-- AM (BROWSE_HIDE_VIEWED) -->
-- Every entry of one source that has been viewed at all - read once, when
-- browse's hide-viewed trim is turned on or the listing changes, and held as
-- the answer for the rest of that listing. Deliberately a one-shot read and
-- not a subscription: a trim that moved with the table would take entries off
-- a listing nobody had touched.
--
-- Whole source rather than the loaded page's ids: the trim is applied to the
-- paging data on every collection, so it has no fixed set of ids to ask about.
--
-- Either origin counts: a card the scroller feed auto-played was opened as
-- surely as an episode started in the player, and "viewed" here means opened,
-- not marked seen - which is why this reads history rather than episodes.seen.
-- One episode is enough for the entry.
--
-- last_seen > 0 is the same "not reset" test the history list itself applies
-- (see historyView.sq): clearing an entry from history un-views it.
getViewedAnimeIdsBySource:
SELECT DISTINCT A._id
FROM animes A
JOIN episodes EP
ON A._id = EP.anime_id
JOIN history H
ON EP._id = H.episode_id
WHERE A.source = :sourceId AND H.last_seen > 0;
-- <-- AM (BROWSE_HIDE_VIEWED)

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE last_seen = 0;

-- AM (HISTORY_ORIGIN): a player write always wins and takes the row's origin
-- with it. A feed write updates only a row the feed already owns, so scrolling
-- past something you have genuinely watched neither rewrites its record nor
-- bumps it back to the top of the list.
upsert:
INSERT INTO history(episode_id, last_seen, origin)
VALUES (:episodeId, :seenAt, :origin)
ON CONFLICT(episode_id)
DO UPDATE
SET
    last_seen = :seenAt,
    origin = :origin
WHERE episode_id = :episodeId AND (:origin = 0 OR history.origin = 1);

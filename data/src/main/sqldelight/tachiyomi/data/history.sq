import java.util.Date;

CREATE TABLE history(
    _id INTEGER NOT NULL PRIMARY KEY,
    episode_id INTEGER NOT NULL UNIQUE,
    last_seen INTEGER AS Date,
    -- AM (HISTORY_ORIGIN): 0 = watched in the player, 1 = seen in the browse
    -- feed. See HistoryOrigin, and the upsert below for why a feed write may
    -- not take a row the player owns.
    origin INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(episode_id) REFERENCES episodes (_id)
    ON DELETE CASCADE
);

CREATE INDEX history_history_episode_id_index ON history(episode_id);
CREATE INDEX idx_history_last_seen ON history(last_seen);

getHistoryByAnimeId:
SELECT
H._id,
H.episode_id,
H.last_seen
FROM history H
JOIN episodes EP
ON H.episode_id = EP._id
WHERE EP.anime_id = :animeId AND EP._id = H.episode_id;

getHistoryByEpisodeUrlAndAnimeId:
SELECT
H._id,
H.episode_id,
H.last_seen
FROM history H
JOIN episodes EP
ON H.episode_id = EP._id
WHERE EP.url = :episodeUrl AND EP.anime_id = :animeId AND EP._id = H.episode_id
LIMIT 1;

resetHistoryById:
UPDATE history
SET last_seen = 0
WHERE _id = :historyId;

resetHistoryByAnimeId:
UPDATE history
SET last_seen = 0
WHERE _id IN (
    SELECT H._id
    FROM animes A
    INNER JOIN episodes EP
    ON A._id = EP.anime_id
    INNER JOIN history H
    ON EP._id = H.episode_id
    WHERE A._id = :animeId
);

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE last_seen = 0;

-- AM (HISTORY_ORIGIN): a player write always wins and takes the row's origin
-- with it. A feed write updates only a row the feed already owns, so scrolling
-- past something you have genuinely watched neither rewrites its record nor
-- bumps it back to the top of the list.
upsert:
INSERT INTO history(episode_id, last_seen, origin)
VALUES (:episodeId, :seenAt, :origin)
ON CONFLICT(episode_id)
DO UPDATE
SET
    last_seen = :seenAt,
    origin = :origin
WHERE episode_id = :episodeId AND (:origin = 0 OR history.origin = 1);

-- AM (MERGED_SOURCES) -->
-- Keyed by episode_id alone since migration 148. It used to be
-- (anime_id, episode_id), which meant the same episode opened from two
-- different library entries - a merged entry and one of its children, most
-- obviously - kept two independent positions and silently reverted to a stale
-- one when you switched back. episodes._id is globally unique and a playback
-- position is a property of the episode, not of the entry you reached it
-- through, so anime_id was never part of the identity.
-- <-- AM (MERGED_SOURCES)
CREATE TABLE episode_temp_positions(
    episode_id INTEGER NOT NULL PRIMARY KEY,
    position_ms INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX episode_temp_positions_updated_at_index ON episode_temp_positions(updated_at);

getAll:
SELECT episode_id, position_ms, updated_at
FROM episode_temp_positions
ORDER BY updated_at DESC;

upsert:
INSERT INTO episode_temp_positions(episode_id, position_ms, updated_at)
VALUES (:episodeId, :positionMs, :updatedAt)
ON CONFLICT(episode_id)
DO UPDATE
SET
    position_ms = :positionMs,
    updated_at = :updatedAt;

deleteByKey:
DELETE FROM episode_temp_positions
WHERE episode_id = :episodeId;

-- Keeps only the :keepCount most-recently-updated rows, by rowid rather than a
-- row-value tuple comparison so it doesn't depend on the composite primary key
-- being usable in a row-value IN (...) subquery.
pruneToMostRecent:
DELETE FROM episode_temp_positions
WHERE rowid NOT IN (
    SELECT rowid
    FROM episode_temp_positions
    ORDER BY updated_at DESC
    LIMIT :keepCount
);

deleteAll:
DELETE FROM episode_temp_positions;

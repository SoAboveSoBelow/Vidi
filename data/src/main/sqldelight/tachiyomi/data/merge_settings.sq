-- AM (MERGE_SETTINGS) -->
-- Per-merge settings. A merge with no row uses the defaults (dedupe off, the
-- highest-priority source as the info entry), so a row only exists once the
-- user changes something.
--
-- dedupe_mode: 0 = off, 1 = prefer higher priority (see DedupeMode).
-- info_anime_id: the source whose details the merged entry shows. SET NULL on
-- delete falls back to the default rather than pointing at a missing entry.
CREATE TABLE merge_settings(
    merge_parent_id INTEGER NOT NULL PRIMARY KEY,
    dedupe_mode INTEGER NOT NULL DEFAULT 0,
    info_anime_id INTEGER,
    FOREIGN KEY(merge_parent_id) REFERENCES animes(_id)
    ON DELETE CASCADE,
    FOREIGN KEY(info_anime_id) REFERENCES animes(_id)
    ON DELETE SET NULL
);

getByMergeParentId:
SELECT merge_parent_id, dedupe_mode, info_anime_id
FROM merge_settings
WHERE merge_parent_id = :mergeParentId;

upsert:
INSERT OR REPLACE INTO merge_settings(merge_parent_id, dedupe_mode, info_anime_id)
VALUES (:mergeParentId, :dedupeMode, :infoAnimeId);
-- <-- AM (MERGE_SETTINGS)

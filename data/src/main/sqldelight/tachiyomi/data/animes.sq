import eu.kanade.tachiyomi.animesource.model.AnimeUpdateStrategy;
import eu.kanade.tachiyomi.animesource.model.FetchType;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE animes(
    _id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    url TEXT NOT NULL,
    artist TEXT,
    author TEXT,
    description TEXT,
    genre TEXT AS List<String>,
    title TEXT NOT NULL,
    status INTEGER NOT NULL,
    thumbnail_url TEXT,
    favorite INTEGER AS Boolean NOT NULL,
    last_update INTEGER,
    next_update INTEGER,
    initialized INTEGER AS Boolean NOT NULL,
    viewer INTEGER NOT NULL,
    episode_flags INTEGER NOT NULL,
    cover_last_modified INTEGER NOT NULL,
    date_added INTEGER NOT NULL,
    update_strategy INTEGER AS AnimeUpdateStrategy NOT NULL DEFAULT 0,
    calculate_interval INTEGER DEFAULT 0 NOT NULL,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    favorite_modified_at INTEGER,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    notes TEXT NOT NULL DEFAULT "",
    -- AY -->
    fetch_type INTEGER AS FetchType NOT NULL DEFAULT 1,
    parent_id INTEGER,
    season_flags INTEGER NOT NULL,
    season_number REAL NOT NULL,
    season_source_order INTEGER NOT NULL,
    background_url TEXT,
    background_last_modified INTEGER NOT NULL,
    -- <-- AY
    memo BLOB AS JsonObject NOT NULL DEFAULT '{}'
);

CREATE INDEX library_favorite_index ON animes(favorite) WHERE favorite = 1;
CREATE INDEX animes_url_index ON animes(url);
CREATE INDEX idx_animes_source ON animes(source);
-- AY -->
CREATE INDEX animes_parent_id ON animes(parent_id);
CREATE INDEX animes_fetch_type ON animes(fetch_type);
-- <-- AY

CREATE TRIGGER update_last_favorited_at_animes
AFTER UPDATE OF favorite ON animes
BEGIN
  UPDATE animes
  SET favorite_modified_at = strftime('%s', 'now')
  WHERE _id = new._id;
END;

CREATE TRIGGER update_last_modified_at_animes
AFTER UPDATE ON animes
FOR EACH ROW
BEGIN
  UPDATE animes
  SET last_modified_at = strftime('%s', 'now')
  WHERE _id = new._id;
END;

CREATE TRIGGER update_anime_version AFTER UPDATE ON animes
BEGIN
    UPDATE animes SET version = version + 1
    WHERE _id = new._id AND new.is_syncing = 0 AND (
        new.url != old.url OR
        new.description != old.description OR
        new.favorite != old.favorite
    );
END;

getAnimeById:
SELECT *
FROM animes
WHERE _id = :id;

-- TODO: this should ideally never really have more than 1 result
getAnimeByUrlAndSource:
SELECT *
FROM animes
WHERE url = :url
AND source = :source
LIMIT 1;

getFavorites:
SELECT *
FROM animes
WHERE favorite = 1;

-- AM (A_BACKUP_IS_WRITTEN_ONE_ENTRY_AT_A_TIME): the same selection, walked by
-- id instead of returned whole. A backup streams its entries out one at a time,
-- so materialising every non-library entry first would reintroduce the
-- allocation the streaming exists to avoid - on a heavily browsed source this
-- side of it is a hundred thousand rows.
-- AM (A_PROGRESS_IS_A_PER_ENTRY_QUESTION) -->
-- EXISTS per candidate entry, not one DISTINCT list of every entry with
-- progress. The list form was built from scratch on each call - a full walk of
-- episodes_anime_id_index, since `seen = 1 OR last_second_seen != 0` indexes
-- no better than that - which made the id walk below quadratic in the thing it
-- exists to page through: every batch paid for the whole episodes table again.
-- Correlated, it is one index seek per entry examined and it stops at the
-- first episode with progress.
--
-- Measured at 120k animes / 150k episodes / 102k history, 38k entries with
-- progress outside the library, identical rows at every offset: 24-31 ms per
-- 200-row batch -> 0.5-1.1 ms, and the complete 192-batch walk 5,626 -> 122 ms.
--
-- getSeenAnimeNotReachableFromLibrary, which wants the whole set rather than a
-- page of it, measured FLAT either way (153 vs 153 ms, same 38,333 rows): asked
-- for every row, the DISTINCT list is built once and is no worse than the correlated
-- probe. It is rewritten anyway so one predicate has one spelling, not for
-- speed - the quadratic cost was never in this query, only in paging with it.
--
-- A partial index on (anime_id) WHERE seen = 1 OR last_second_seen != 0 was
-- tried and rejected: SQLite does match it against this predicate, but it only
-- took the batch from 0.65 to 0.55 ms - under perception either way - for
-- 560 KB and another index to maintain on every episode write.
-- AM (A_BACKUP_CARRIES_WHAT_A_MERGE_IS_MADE_OF) -->
-- Renamed from getSeenAnimeNotInLibrary[After]. Two things are excluded now,
-- and only one of them is the favorite flag: children of favorited merged
-- entries carry favorite = 0 but are reachable from the library through
-- merge_children (see getLibraryMergeChildAnimeIds there), so "not in library"
-- was never true of them. The backup writes them from
-- getNonFavoriteLibraryMergeChildren, and without the exclusion below any child
-- that also has progress would be written twice.
--
-- The name says "not reachable from" rather than "not in" so a later caller
-- wanting the plain favorite test does not reach for this one by its name and
-- silently lose merge children.
--
-- Cost is one index seek per candidate on merge_children_anime_id_index,
-- stopping at the first row; that table holds a row per membership, not per
-- entry.
getSeenAnimeNotReachableFromLibraryAfter:
SELECT *
FROM animes
WHERE favorite = 0 AND _id > :afterId
AND EXISTS (
    SELECT 1
    FROM episodes
    WHERE episodes.anime_id = animes._id
    AND (episodes.seen = 1 OR episodes.last_second_seen != 0)
)
AND NOT EXISTS (
    SELECT 1
    FROM merge_children MC
    JOIN animes P ON P._id = MC.merge_parent_id
    WHERE MC.anime_id = animes._id AND P.favorite = 1
)
ORDER BY _id
LIMIT :limit;

getSeenAnimeNotReachableFromLibrary:
SELECT *
FROM animes
WHERE favorite = 0
AND EXISTS (
    SELECT 1
    FROM episodes
    WHERE episodes.anime_id = animes._id
    AND (episodes.seen = 1 OR episodes.last_second_seen != 0)
)
AND NOT EXISTS (
    SELECT 1
    FROM merge_children MC
    JOIN animes P ON P._id = MC.merge_parent_id
    WHERE MC.anime_id = animes._id AND P.favorite = 1
);
-- <-- AM (A_BACKUP_CARRIES_WHAT_A_MERGE_IS_MADE_OF)
-- <-- AM (A_PROGRESS_IS_A_PER_ENTRY_QUESTION)

getAllAnime:
SELECT *
FROM animes;

getAllAnimeSourceAndUrl:
SELECT source, url
FROM animes;

getAnimesWithFavoriteTimestamp:
SELECT *
FROM animes
WHERE favorite_modified_at IS NOT NULL;

getSourceIdWithFavoriteCount:
SELECT
source,
count(*)
FROM animes
WHERE favorite = 1
GROUP BY source;

getFavoriteBySourceId:
SELECT *
FROM animes
WHERE favorite = 1
AND source = :sourceId;

-- AM (MERGED_SOURCES) -->
-- The two queries above, widened from "favorited" to "in the library by any
-- route". A source that only exists inside a merged entry carries favorite = 0
-- once the originals were removed, which hid it from migration entirely: the
-- source did not appear in the migrate list and its entries could not be
-- selected, even though the library still plays them through the merge.
--
-- Kept as separate queries rather than widening the favorite ones: everything
-- else that asks about favorite really does mean the flag.
getSourceIdWithLibraryCount:
SELECT
source,
count(*)
FROM animes
WHERE favorite = 1
OR _id IN (
    SELECT MC.anime_id FROM merge_children MC
    JOIN animes P ON P._id = MC.merge_parent_id
    WHERE P.favorite = 1
)
GROUP BY source;

getLibraryEntriesBySourceId:
SELECT *
FROM animes
WHERE source = :sourceId
AND (
    favorite = 1
    OR _id IN (
        SELECT MC.anime_id FROM merge_children MC
        JOIN animes P ON P._id = MC.merge_parent_id
        WHERE P.favorite = 1
    )
);
-- <-- AM (MERGED_SOURCES)

getDuplicateLibraryAnime:
WITH
track_dupes AS (
    SELECT DISTINCT S2.anime_id
    FROM anime_sync S1
    INNER JOIN anime_sync S2
    ON S1.sync_id = S2.sync_id
    AND S1.remote_id = S2.remote_id
    AND S1.anime_id != S2.anime_id
    WHERE S1.anime_id = :id
),
duplicates AS (
    SELECT A.*
    FROM animes A
    LEFT JOIN track_dupes D
    ON D.anime_id = _id
    -- AM (MERGED_SOURCES) -->
    -- A source held only through a merged entry is in the library as far as the
    -- user is concerned, so adding the same title again is just as much a
    -- duplicate as re-adding a favorited one.
    --
    -- The merged entry itself is excluded: it is not an entry from any source,
    -- so it can never be the thing being re-added, and listing it alongside the
    -- source it is made of would report the same title twice.
    WHERE source != -1
    AND (
        favorite = 1
        OR _id IN (
            SELECT MC.anime_id FROM merge_children MC
            JOIN animes P ON P._id = MC.merge_parent_id
            WHERE P.favorite = 1
        )
    )
    -- <-- AM (MERGED_SOURCES)
    AND _id != :id
    AND (lower(title) LIKE '%' || lower(:title) || '%' OR D.anime_id IS NOT NULL)
),
episode_counts AS (
    SELECT
        A._id AS anime_id,
        count(*) AS episode_count
    FROM duplicates A
    JOIN episodes EP
    ON A._id = EP.anime_id
    LEFT JOIN excluded_scanlators ES
    ON EP.anime_id = ES.anime_id
    AND EP.scanlator = ES.scanlator
    WHERE ES.scanlator IS NULL
    GROUP BY A._id
)
SELECT
    A.*,
    coalesce(EC.episode_count, 0) AS episode_count
FROM duplicates A
LEFT JOIN episode_counts EC
ON A._id = EC.anime_id;

getUpcomingAnime:
SELECT *
FROM animes
WHERE next_update >= :startOfDay
AND favorite = 1
AND status IN :statuses
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM animes_categories
        WHERE animes_categories.anime_id = animes._id
        AND COALESCE(animes_categories.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM animes_categories WHERE animes_categories.anime_id = animes._id)
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM animes_categories
            WHERE animes_categories.anime_id = animes._id
            AND COALESCE(animes_categories.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM animes_categories WHERE animes_categories.anime_id = animes._id)
        )
    )
)
ORDER BY next_update ASC;

resetViewerFlags:
UPDATE animes
SET viewer = 0;

resetIsSyncing:
UPDATE animes
SET is_syncing = 0
WHERE is_syncing = 1;

-- AY -->
removeParentIdByIds:
UPDATE animes
SET parent_id = NULL
WHERE _id IN :animeIds;

getChildrenByParentId:
SELECT *
FROM animes
WHERE parent_id = :parentId;
-- <-- AY

-- AM (SEASON_PARENT_LINK) -->
-- Sets one entry's season parent outright, including to NULL. The general
-- `update` above writes parent_id through coalesce(:parentId, parent_id), so it
-- can only ever set a parent, never clear one - which is why relinking seasons
-- after a restore needs a query of its own.
setParentId:
UPDATE animes
SET parent_id = :parentId
WHERE _id = :animeId;
-- <-- AM (SEASON_PARENT_LINK)

-- AM (MERGED_SOURCES) -->
-- Second keepSeenAnime guard below: a merge parent owns no episodes, so the
-- first guard can never match it and the exclude-seen-entries toggle would
-- silently drop a fully watched merged entry. Its watch progress lives on its
-- children, so protect it when any child has progress.
-- <-- AM (MERGED_SOURCES)
-- AM (A_PROGRESS_IS_A_PER_ENTRY_QUESTION): both guards as NOT EXISTS, for the
-- reason above. The id list bounds the delete to a handful of rows, but each
-- DISTINCT subquery was still built over the whole episodes table - twice when
-- both guards were on. Safe as NOT EXISTS because episodes.anime_id and
-- merge_children.merge_parent_id are both NOT NULL, so there is no NOT IN
-- null-propagation to preserve. Measured with 50 ids at the sizes above, same
-- rows deleted for all four flag combinations: 46 -> 0.05 ms.
-- AM (A_A_SOURCE_HAS_LIBRARY_DATA_TOO) -->
-- The library side of animedeletableView, which is deliberately favorite = 0
-- only: nothing could previously ask what a source holds IN the library, so
-- clearing a source's data meant clearing the half of it the user had not kept.
--
-- The same two guards as that view, for the same reasons. parent_id IS NULL
-- keeps a child out of a list whose rows are deleted whole - a parent's delete
-- takes its children with it - and the merge_children exclusion keeps a delete
-- from cascading a merge_children row away and gutting a merge that is still in
-- the library (see MERGED_SOURCES on that view).
getLibraryParentAnime:
SELECT _id, source, fetch_type
FROM animes
WHERE favorite = 1
AND parent_id IS NULL
AND _id NOT IN (SELECT anime_id FROM merge_children);

-- Unconditional, unlike deleteAnimesNotInLibraryByAnimeIds below: the ids come
-- from a list the user has been shown and a confirmation that names what is
-- about to go, so a favorite guard here would silently do nothing rather than
-- what was asked. Being the one query in this file that will delete a library
-- entry, it is reached from exactly one place - the per-source dialog, behind
-- its own warning.
deleteAnimesByAnimeIds:
DELETE FROM animes
WHERE _id IN :animeIds;
-- <-- AM (A_A_SOURCE_HAS_LIBRARY_DATA_TOO)

deleteAnimesNotInLibraryByAnimeIds:
DELETE FROM animes
WHERE favorite = 0
AND _id IN :animeIds
AND (
    :keepSeenAnime = 0
    OR NOT EXISTS (
        SELECT 1
        FROM episodes
        WHERE episodes.anime_id = animes._id
        AND (episodes.seen = 1 OR episodes.last_second_seen != 0)
    )
)
AND (
    :keepSeenAnime = 0
    OR NOT EXISTS (
        SELECT 1
        FROM merge_children MC
        WHERE MC.merge_parent_id = animes._id
        AND EXISTS (
            SELECT 1
            FROM episodes
            WHERE episodes.anime_id = MC.anime_id
            AND (episodes.seen = 1 OR episodes.last_second_seen != 0)
        )
    )
);

insertReturningId:
INSERT INTO animes(source, url, artist, author, description, genre, title, status, thumbnail_url, favorite, last_update, next_update, initialized, viewer, episode_flags, cover_last_modified, date_added, update_strategy, calculate_interval, last_modified_at, version, notes, fetch_type, parent_id, season_flags, season_number, season_source_order, background_url, background_last_modified, memo)
VALUES (:source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favorite, :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :episodeFlags, :coverLastModified, :dateAdded, :updateStrategy, :calculateInterval, 0, :version, :notes, :fetchType, :parentId, :seasonFlags, :seasonNumber, :seasonSourceOrder, :backgroundUrl, :backgroundLastModified, :memo)
RETURNING _id;

update:
UPDATE animes SET
    source = coalesce(:source, source),
    url = coalesce(:url, url),
    artist = coalesce(:artist, artist),
    author = coalesce(:author, author),
    description = coalesce(:description, description),
    genre = coalesce(:genre, genre),
    title = coalesce(:title, title),
    status = coalesce(:status, status),
    thumbnail_url = coalesce(:thumbnailUrl, thumbnail_url),
    favorite = coalesce(:favorite, favorite),
    last_update = coalesce(:lastUpdate, last_update),
    next_update = coalesce(:nextUpdate, next_update),
    initialized = coalesce(:initialized, initialized),
    viewer = coalesce(:viewer, viewer),
    episode_flags = coalesce(:episodeFlags, episode_flags),
    cover_last_modified = coalesce(:coverLastModified, cover_last_modified),
    date_added = coalesce(:dateAdded, date_added),
    update_strategy = coalesce(:updateStrategy, update_strategy),
    calculate_interval = coalesce(:calculateInterval, calculate_interval),
    version = coalesce(:version, version),
    is_syncing = coalesce(:isSyncing, is_syncing),
    notes = coalesce(:notes, notes),
    -- AY -->
    fetch_type = coalesce(:fetchType, fetch_type),
    parent_id = coalesce(:parentId, parent_id),
    season_flags = coalesce(:seasonFlags, season_flags),
    season_number = coalesce(:seasonNumber, season_number),
    season_source_order = coalesce(:seasonSourceOrder, season_source_order),
    background_url = coalesce(:backgroundUrl, background_url),
    background_last_modified = coalesce(:backgroundLastModified, background_last_modified),
    -- <-- AY
    memo = coalesce(:memo, memo)
WHERE _id = :animeId;

insertNetworkAnime {
    -- Insert the anime if it doesn't exist already
    INSERT INTO animes(
        source, url, artist, author, description, genre, title, status, thumbnail_url, favorite,
        last_update, next_update, initialized, viewer, episode_flags, cover_last_modified, date_added,
        update_strategy, calculate_interval, last_modified_at, version, fetch_type, parent_id, season_flags,
        season_number, season_source_order, background_url, background_last_modified, memo
    )
    SELECT
        :source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favorite,
        :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :episodeFlags, :coverLastModified, :dateAdded,
        :updateStrategy, :calculateInterval, 0, :version, :fetchType, :parentId, :seasonFlags, :seasonNumber,
        :seasonSourceOrder, :backgroundUrl, :backgroundLastModified, :memo
    WHERE NOT EXISTS(SELECT 0 FROM animes WHERE source = :source AND url = :url);

    -- Update the relevant details if applicable and not favorite
    UPDATE animes
    SET
        title = CASE WHEN :updateTitle THEN :title ELSE title END,
        thumbnail_url = CASE WHEN :updateCover THEN :thumbnailUrl ELSE thumbnail_url END,
        author = CASE WHEN :updateDetails THEN :author ELSE author END,
        artist = CASE WHEN :updateDetails THEN :artist ELSE artist END,
        description = CASE WHEN :updateDetails THEN :description ELSE description END,
        genre = CASE WHEN :updateDetails THEN :genre ELSE genre END,
        status = CASE WHEN :updateDetails THEN :status ELSE status END,
        update_strategy = CASE WHEN :updateDetails THEN :updateStrategy ELSE update_strategy END,
        initialized = :updateDetails,
        -- AY -->
        season_number = CASE WHEN :updateDetails THEN :seasonNumber ELSE season_number END,
        season_source_order = CASE WHEN :updateDetails THEN :seasonSourceOrder ELSE season_source_order END,
        background_url = CASE WHEN :updateDetails THEN :backgroundUrl ELSE background_url END,
        -- <-- AY
        memo = :memo
    WHERE source = :source
    AND url = :url
    AND favorite = 0;

    -- Finally return the anime
    SELECT *
    FROM animes
    WHERE source = :source
    AND url = :url
    LIMIT 1;
}
